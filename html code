  <script>
    document.getElementById("orderForm").addEventListener("submit", function(event) {
      event.preventDefault();

      const name = document.getElementById("name").value.trim();
      const governorate = document.getElementById("governorate").value.trim();
      const address = document.getElementById("address").value.trim();

      const message =
        "السلام عليكم، أريد طلب جهاز تتبع السيارات S20 من متجر الإبداع.%0A%0A" +
        "الاسم الثلاثي: " + encodeURIComponent(name) + "%0A" +
        "المحافظة: " + encodeURIComponent(governorate) + "%0A" +
        "العنوان: " + encodeURIComponent(address);

      window.open(
        "https://wa.me/963938294243?text=" + message,
        "_blank"
      );
    });
  </script>

</body>
</html>
